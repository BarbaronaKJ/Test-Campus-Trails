{
  "name": "interactive-map",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "concurrently --kill-others-on-fail -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run backend\" \"npm run frontend\"",
    "dev:ngrok": "concurrently --kill-others-on-fail -n \"BACKEND,FRONTEND,NGROK\" -c \"bgBlue.bold,bgMagenta.bold,bgGreen.bold\" \"npm run backend\" \"npm run frontend\" \"npm run ngrok\"",
    "backend": "cd backend && npm start",
    "frontend": "expo start",
    "ngrok": "ngrok http 3000"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "^4.5.5",
    "expo": "~52.0.18",
    "expo-image": "~1.12.8",
    "expo-image-picker": "^17.0.10",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "^2.21.2",
    "react-native-image-pan-zoom": "^2.1.12",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-reanimated": "^3.16.5",
    "react-native-svg": "^15.10.1",
    "react-native-web": "~0.19.13",
    "react-native-webview": "^13.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "concurrently": "^9.1.0",
    "react-native-svg-transformer": "^1.5.2"
  },
  "private": true
}
